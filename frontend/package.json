    "react-router-dom": "^7.6.0",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.0",
