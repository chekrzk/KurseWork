{
 email {$ACME_EMAIL}
 on_demand_tls {
  ask http://backend:8080/internal/caddy/allow-domain
 }
}
(safety) {
 @internal path /internal/*
 respond @internal 404
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy strict-origin-when-cross-origin
  X-Frame-Options DENY
  Strict-Transport-Security "max-age=31536000"
 }
}
(api) {
 reverse_proxy backend:8080 {
  header_up X-Pulse-IP {remote_host}
 }
}
saturnita.ru {
 import safety
 @api path /api/* /healthz /readyz
 handle @api {
  import api
 }
 handle {
  root * /srv
  try_files {path} /index.html
  encode zstd gzip
  file_server
 }
}
*.saturnita.ru {
 tls /certs/wildcard.pem /certs/wildcard.key
 import safety
 import api
}
https:// {
 tls {
  on_demand
 }
 import safety
 import api
}
